[Unit]
Description=PlainNVR signed OS update worker
After=network.target plainnvr-ab-prepare.service
# Downloads have their own bounded network errors. Installing a verified local
# bundle or selecting rollback must also work with the network disconnected.
RequiresMountsFor=/persist
ConditionPathExists=/etc/plainnvr/ab.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/plainnvr/update/worker.py
TimeoutStartSec=2h
UMask=0077
