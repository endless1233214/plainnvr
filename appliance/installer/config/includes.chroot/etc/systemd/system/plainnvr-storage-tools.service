[Unit]
Description=PlainNVR installer disk tools
After=systemd-user-sessions.service
Conflicts=getty@tty1.service plainnvr-kiosk@tty1.service
ConditionKernelCommandLine=plainnvr.storage-tools

[Service]
ExecStart=/usr/bin/xinit /usr/sbin/gparted -- :0 vt1 -nolisten tcp
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
